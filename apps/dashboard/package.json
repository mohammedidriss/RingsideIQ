{
  "name": "alion-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "mediapipe": "node scripts/mediapipe-assets.mjs",
    "predev": "npm run mediapipe",
    "predev:lan": "npm run mediapipe",
    "predev:https": "npm run mediapipe",
    "prebuild": "npm run mediapipe",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "dev:lan": "NEXT_TELEMETRY_DISABLED=1 next dev --port 3000 -H 0.0.0.0",
    "dev:https": "NEXT_TELEMETRY_DISABLED=1 next dev --experimental-https --experimental-https-key ./certs/lan-key.pem --experimental-https-cert ./certs/lan-cert.pem --port 3000 -H 0.0.0.0",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "lint": "NEXT_TELEMETRY_DISABLED=1 next lint",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript http://localhost:8000/openapi.json -o lib/api-schema.ts",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap sync ios && npx cap open ios",
    "cap:android": "npx cap sync android && npx cap open android",
    "cap:dev:ios": "CAPACITOR_SERVER_URL=http://$(ipconfig getifaddr en0):3000 npx cap run ios",
    "cap:dev:android": "CAPACITOR_SERVER_URL=http://$(ipconfig getifaddr en0):3000 npx cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@capgo/capacitor-updater": "^8.46.1",
    "@mediapipe/tasks-vision": "^0.10.35",
    "next": "14.2.5",
    "qrcode.react": "^4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "openapi-typescript": "^7.13.0",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
